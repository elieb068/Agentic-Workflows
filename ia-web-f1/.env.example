# Copy to .env and fill in. Never commit .env.
# Variables are added per milestone; see CLAUDE.md for the stack.

# Public base URL (used in report links /r/{token})
APP_BASE_URL=http://localhost:8000

# Identifiable UA for our fetcher (see /bot page)
FETCHER_USER_AGENT="RaioXIA-Bot/0.1 (+http://localhost:8000/bot)"

# Optional: directory with ai_agents.yaml and scoring.yaml (defaults to ./config)
# RAIOXIA_CONFIG_DIR=/app/config
