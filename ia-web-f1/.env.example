# Copy to .env and fill in. Never commit .env.
# Variables are added per milestone; see CLAUDE.md for the stack.

# Public base URL (used in report links /r/{token}). Production: https://raiox.primesolutions.net.br
APP_BASE_URL=http://localhost:8000

# Identifiable UA for our fetcher (see /bot page)
FETCHER_USER_AGENT="RaioXIA-Bot/0.1 (+http://localhost:8000/bot)"

# Optional: directory with ai_agents.yaml and scoring.yaml (defaults to ./config)
# RAIOXIA_CONFIG_DIR=/app/config

# Optional: Chromium binary for Playwright (check 5). Leave empty to use Playwright's own
# browser (the official Playwright Docker image ships the matching one).
# CHROMIUM_EXECUTABLE=/opt/pw-browsers/chromium
# The playwright package is pinned to the image tag (pyproject.toml): bump both together.

# --- M2 pipeline -------------------------------------------------------------

# Signs unsubscribe and data-deletion links (min 32 chars). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Defaults match compose.dev.yaml (127.0.0.1:15432 / :16379; not "localhost", which tries IPv6 first and stalls on Docker Desktop).
DATABASE_URL=postgresql+psycopg://raioxia:raioxia@127.0.0.1:15432/raioxia
REDIS_URL=redis://127.0.0.1:16379/0

# Cloudflare Turnstile. Defaults are Cloudflare's always-pass test keys (they accept the dummy token
# "XXXX.DUMMY.TOKEN.XXXX", e.g. with curl); set real ones in production. Submission limits: config/limits.yaml.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Proxies allowed to set X-Forwarded-For, as a JSON list of networks.
# TRUSTED_PROXIES=["127.0.0.0/8","172.16.0.0/12","::1/128"]

# E-mail: "console" prints messages to the log (dev); "gmail" sends through the Gmail API with a
# Workspace service account (domain-wide delegation, scope gmail.send only).
EMAIL_SENDER=console
EMAIL_FROM_ADDRESS=raiox@primesolutions.net.br
EMAIL_FROM_NAME="Raio-X IA"
GMAIL_DELEGATED_USER=eric.lieb@primesolutions.net.br
# Path to the service account JSON key. Keep it outside the repo, readable only by the e-mail worker.
# GMAIL_SERVICE_ACCOUNT_FILE=/run/secrets/gmail-service-account.json

LOG_LEVEL=INFO
# JSON lines (production); set false for human-readable logs while developing.
LOG_JSON=true
