# Production settings: copy to /home/ubuntu/raioxia/.env (chmod 600). Never commit the real file.
# Values in <> must be filled; generate secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

APP_BASE_URL=https://raiox.primesolutions.net.br
SECRET_KEY=<generated>

POSTGRES_PASSWORD=<generated, url-safe>
DATABASE_URL=postgresql+psycopg://raioxia:<same password>@postgres:5432/raioxia
REDIS_URL=redis://redis:6379/0

# Cloudflare Turnstile widget for raiox.primesolutions.net.br
TURNSTILE_SITE_KEY=<site key>
TURNSTILE_SECRET_KEY=<secret key>

# The shared Caddy (wordpress_caddy) is on the Docker network wordpress_default.
TRUSTED_PROXIES=["172.18.0.0/16"]

EMAIL_SENDER=gmail
EMAIL_FROM_ADDRESS=raiox@primesolutions.net.br
EMAIL_FROM_NAME="Raio-X IA"
GMAIL_DELEGATED_USER=eric.lieb@primesolutions.net.br
GMAIL_SERVICE_ACCOUNT_FILE=/run/secrets/gmail-service-account.json

FETCHER_USER_AGENT="RaioXIA-Bot/0.1 (+https://raiox.primesolutions.net.br/bot)"
SERVER_IP=163.176.179.23

# Google AdSense (report page only). Slot IDs come after the site is approved.
ADSENSE_CLIENT=ca-pub-5217885742353376
ADSENSE_SLOT_TOP=
ADSENSE_SLOT_BOTTOM=
# Auto ads: AdSense loader also on the landing page; Google places ads (formats set in AdSense).
ADSENSE_AUTO_ADS=true

LOG_LEVEL=INFO
LOG_JSON=true
